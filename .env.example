# ============================================
# APPLICATION SETTINGS
# ============================================
APP_NAME=AI Loan Predictor
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=True

# ============================================
# SERVER CONFIGURATION
# ============================================
HOST=0.0.0.0
PORT=8000

# ============================================
# MONGODB ATLAS
# ============================================
MONGO_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@cluster0.xxxxx.mongodb.net/loanpredictor?retryWrites=true&w=majority&appName=Cluster0
DATABASE_NAME=loanpredictor

# ============================================
# JWT AUTHENTICATION
# ============================================
JWT_SECRET_KEY=Replace_With_A_Strong_Secret_Key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================
# MACHINE LEARNING
# ============================================
MODEL_PATH=ml/model.pkl
SCALER_PATH=ml/scaler.pkl

# ============================================
# FILE UPLOADS
# ============================================
UPLOAD_FOLDER=uploads
MAX_UPLOAD_SIZE=10485760

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=INFO
LOG_FILE=logs/application.log

# ============================================
# CORS
# ============================================
ALLOWED_ORIGINS=http://localhost:8501,http://localhost:3000

# ============================================
# STREAMLIT
# ============================================
STREAMLIT_SERVER_PORT=8501

# ============================================
# SECURITY
# ============================================
PASSWORD_HASH_SCHEME=bcrypt
SESSION_TIMEOUT=3600

# ============================================
# EMAIL (Optional)
# ============================================
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# ============================================
# AI LOAN PREDICTOR
# ============================================
DEFAULT_CIBIL_SCORE=650
MIN_CIBIL_SCORE=300
MAX_CIBIL_SCORE=900
DEFAULT_LOAN_LIMIT=1000000

# ============================================
# MODEL INFORMATION
# ============================================
MODEL_NAME=RandomForestClassifier
MODEL_VERSION=1.0
MODEL_ACCURACY=0.92

# ============================================
# HEALTH CHECK
# ============================================
ENABLE_HEALTH_CHECK=True

# ============================================
# ADMIN
# ============================================
ADMIN_EMAIL=admin@loanpredictor.com
ADMIN_PASSWORD=ChangeThisPassword

# ============================================
# API DOCUMENTATION
# ============================================
API_PREFIX=/api
API_TITLE=AI Loan Predictor API
API_DESCRIPTION=Loan Approval Prediction using Machine Learning
API_VERSION=1.0.0
